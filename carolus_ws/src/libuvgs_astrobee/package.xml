<package format="2">
  <name>carolus_astrobee</name>
  <version>0.0.1</version>
  <description>The carolus_node package</description>

  <maintainer email="ZAUBERFLOTE1@GITHUB.com">ZAUBERFLOTE1</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>

  <build_depend>geometry_msgs</build_depend>
  
  <build_depend>ff_msgs</build_depend>

  <build_depend>libopencv-dev</build_depend>
  <build_depend>eigen</build_depend>
  <!-- 2026-08-13 (BUG-112): CMakeLists.txt:20 calls find_package(Ceres
       REQUIRED) but it was never declared here, so rosdep never installed it
       and the build died at CMake configure with "Could not find
       FindCeres.cmake". The rosdep key is the literal apt name
       `libceres-dev`; plain `ceres` is NOT a registered rosdep key, checked. -->
  <build_depend>libceres-dev</build_depend>
  <build_depend>image_transport</build_depend>
  
  


  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  
  <exec_depend>ff_msgs</exec_depend>
  
  
  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>eigen</exec_depend>
  <exec_depend>libceres-dev</exec_depend>
  <exec_depend>image_transport</exec_depend>


  <export>
  </export>
</package>
