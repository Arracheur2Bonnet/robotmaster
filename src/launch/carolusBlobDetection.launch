<launch>
    <node name="carolus_astrobee_rex" pkg="carolus_astrobee" type="carolus_astrobee" output="screen">
        
        <!-- Execution Parameters -->
        <param name="num_threads" value="1" />
        <param name="queue_size" value="10" />

        <!-- Blob Filtering Parameters -->
        <param name="min_circularity" value="0.55" />
        <param name="saturation_threshold" value="10" />
        <param name="min_area" value="10.0" />
        <param name="max_area" value="2000.0" />
        <param name="max_distance_lim" value="800.0" />
        <param name="lb_hue" value="89.0" />
        <param name="ub_hue" value="91.0" />

        <!-- Preprocessing Parameters -->
        <param name="kernel_size_gaussian" value="3" />
        <param name="kernel_size_morph" value="3" />
        <param name="image_threshold" value="220" />

        <!-- Camera Parameters -->
        <param name="nav_cam" value="true" />
        <param name="dock_cam" value="false" />
        <param name="fisheye" value="false" />
        <param name="fov" value="true" />
        <param name="mono" value="false" />

        <!-- Robot Configuration -->
        <param name="bot_name" value="wannabee" />

        <!-- Camera Intrinsic Parameters -->
        <param name="fx" value="644.1213" />
	<param name="fy" value="645.2890" />
	<param name="cx" value="643.4710" />
	<param name="cy" value="372.5166" /> 

        <!-- Distortion Coefficients -->
	<param name="distortion" value="-0.0606 0.0824 -0.0027 0.0009" />

        <!-- Topic Names -->
        <param name="dock_cam_topic" value="/hw/cam_dock" />
        <param name="nav_cam_topic" value="/camera/color/image_raw" />
        <param name="processed_image_topic" value="/postprocessed/image" />
        <param name="pose_topic" value="/loc/ar/features" />

        <!-- Benchtest Mode -->
        <param name="benchtest" value="true" />

        <!-- FIFO Filtering -->
 	<param name="filter_size" value="7" />
 	<param name="translation_threshold" value="0.5" />
 	<param name="rotation_threshold" value="0.3" />
 	<param name="fifo_on" value="true" />

        <!-- Known Beacon Points -->
	<param name="known_points" value="0.0825 0.0 0.0 -0.0825 0.0 0.0 0.0 0.072 0.0 0.0 0.0 0.0555" />

    </node>
</launch>

