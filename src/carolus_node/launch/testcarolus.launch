<launch>
    <!-- ====================================================================
         RoboMaster S1 entry point — this is what T3 in the operator GUI and
         the technical manual launch.

         Behaviour is unchanged from before this file became a wrapper: it
         loads the RoboMaster S1 hardware profile and adds the S1-specific
         static TF. All Carolus parameters now live in
         config/robomaster_s1.yaml, and the node itself is launched by the
         generic carolus.launch, so Carolus can be run on other robots
         without editing this file. See carolus.launch for that path.
         ==================================================================== -->

    <!-- Set to false when running on Ubuntu 20.04 (including the Raspberry
         Pi), where the log4cxx/tinyxml2 preload is unnecessary. -->
    <arg name="ubuntu2204_preload" default="true" />
    <!-- See carolus.launch for why this defaults to true. -->
    <arg name="stamp_from_acquisition" default="true" />

    <include file="$(find carolus_node)/launch/carolus.launch">
        <arg name="config"
             value="$(find carolus_node)/config/robomaster_s1.yaml" />
        <arg name="camera_topic" value="/camera/color/image_raw" />
        <arg name="ubuntu2204_preload" value="$(arg ubuntu2204_preload)" />
        <arg name="stamp_from_acquisition" value="$(arg stamp_from_acquisition)" />
    </include>

    <!-- S1-specific: static transform creating the honey/body frame. -->
    <node pkg="tf2_ros"
          type="static_transform_publisher"
          name="static_honey_body_tf"
          args="0 0 0 0 0 0 camera_link honey/body" />

</launch>
