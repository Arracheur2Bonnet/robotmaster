# .env.example — template of the environment file, SAFE to share/commit.
#
# Copy to `.env` and fill in the real values there. `.env` is gitignored and
# must never be committed, pasted into a prompt, or included in a report.
#
#     cp .env.example .env
#     chmod 600 .env
#     # then edit .env and paste the real key
#
# Load it in a shell before running a manual request:
#
#     set -a; source .env; set +a
#
# ─────────────────────────────────────────────────────────────────────────────

# Tavily — web search + page extraction API (https://app.tavily.com).
# Used MANUALLY: the operator pastes/runs the request themselves, there is no
# automated calling code in this project. See
# research-log/09-tavily/model_prompt_tavily.md for the request templates.
# Format: keys are issued as `tvly-...`.
TAVILY_API_KEY=

# Perplexity — currently used through the WEB CHAT interface only (manual
# copy-paste of the prompt), so NO key is required. This line is a placeholder
# in case an API workflow is ever adopted; leave empty otherwise.
PERPLEXITY_API_KEY=
